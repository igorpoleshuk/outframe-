# HMAC secret for OF-L-… / OF-M-… keys. Required to issue and to verify minted keys.
LICENSE_SECRET=

# Bearer token for POST /api/license/issue
LICENSE_ADMIN_TOKEN=

# Comma-separated extra keys accepted without HMAC (manual comps, tests).
PRO_LICENSE_KEYS=

# Optional payment links. If empty, /checkout opens a mailto invoice.
NEXT_PUBLIC_PAY_LIFETIME_URL=
NEXT_PUBLIC_PAY_MONTHLY_URL=

# Public site URL (SEO / sitemap).
# NEXT_PUBLIC_SITE_URL=https://outframe-phi.vercel.app
